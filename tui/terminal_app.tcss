/* ═══════════════════════════════════════════════════════════════════════════════
   CodeClip TUI - Textual Theme-based styling
   ═══════════════════════════════════════════════════════════════════════════════ */

/* ─────────────────────────────────────────────────────────────────────────────
   GLOBAL SELECTION/FOCUS STYLES - Consistent across all widgets
   ───────────────────────────────────────────────────────────────────────────── */

/* Tree cursor highlight - only show when tree is focused */
Tree>.tree--cursor {
    background: transparent;
    color: $text;
}

Tree:focus>.tree--cursor {
    background: $accent;
    color: $text;
    text-style: bold;
}

Tree>.tree--highlight {
    background: transparent;
}

Tree:focus>.tree--highlight {
    background: $accent 50%;
}

Tree>.tree--highlight-line {
    background: transparent;
}

Tree:focus>.tree--highlight-line {
    background: $accent 30%;
}

/* Checkbox focus/hover */
Checkbox:focus {
    background: $accent;
    color: $text;
    text-style: bold;
}

Checkbox:hover {
    background: $accent 50%;
}

Checkbox.-on:focus {
    background: $accent;
    color: $text;
}

/* Button focus/hover */
Button {
    border: round $primary;
    background: transparent;
    color: $text;
    height: 3;
}

Button:focus {
    background: transparent;
    color: $accent;
    text-style: bold;
    border: double $accent;
}

Button:hover {
    background: transparent;
    color: $accent;
    border: double $accent;
}

Button.-active {
    background: transparent;
    border: round $accent;
    color: $accent;
}

/* ─────────────────────────────────────────────────────────────────────────────
   MAIN LAYOUT
   ───────────────────────────────────────────────────────────────────────────── */
#main-container {
    layout: horizontal;
    height: 1fr;
    width: 100%;
    padding: 0;
}

/* ─────────────────────────────────────────────────────────────────────────────
   LEFT PANEL - FILE TREE
   ───────────────────────────────────────────────────────────────────────────── */
#left-panel {
    width: 2fr;
    min-width: 40;
    height: 100%;
    border: round $primary;
    margin: 0 1 0 0;
    padding: 0;
}

#left-panel:focus-within {
    border: round $accent;
}

#left-panel-title-box {
    height: 1;
    dock: top;
    layout: horizontal;
    padding: 0 1;
}

#tree-title {
    color: $primary;
    text-style: bold;
    width: auto;
}

#tree-stats {
    color: $text-muted;
    text-align: right;
    width: 1fr;
}

#file-tree-container {
    height: 1fr;
    padding: 0 1;
}

#file-tree {
    height: 1fr;
    padding: 0;
}

/* ─────────────────────────────────────────────────────────────────────────────
   RIGHT PANEL - CONTROLS
   ───────────────────────────────────────────────────────────────────────────── */
#right-panel {
    width: 1fr;
    min-width: 28;
    max-width: 40;
    height: 100%;
    layout: vertical;
    padding: 0;
}

/* ─────────────────────────────────────────────────────────────────────────────
   SECTION BOXES
   ───────────────────────────────────────────────────────────────────────────── */
.section-box {
    margin: 0;
    padding: 0 1;
    height: auto;
}

.section-title {
    text-style: bold;
    color: $primary;
    dock: top;
    height: 1;
    padding: 0;
    margin: 0;
}

/* ─────────────────────────────────────────────────────────────────────────────
   FILE TYPES SECTION
   ───────────────────────────────────────────────────────────────────────────── */
#file-types-section {
    height: 1fr;
    min-height: 10;
    border: round $primary;
    margin-bottom: 0;
}

#file-types-section:focus-within {
    border: round $accent;
}

#file-types-header {
    height: 1;
    dock: top;
    layout: horizontal;
    padding: 0;
}

#file-types-header .section-title {
    width: 1fr;
}

#file-types-container {
    height: 1fr;
    padding: 0;
}

.ext-checkbox {
    padding: 0;
    margin: 0;
    border: none;
    height: 1;
}




/* Mini buttons for all/none */
.mini-btn {
    width: 3;
    min-width: 3;
    height: 1;
    border: none;
    padding: 0;
    margin: 0 0 0 1;
}



/* ─────────────────────────────────────────────────────────────────────────────
   STATUS SECTION
   ───────────────────────────────────────────────────────────────────────────── */
#status-section {
    height: auto;
    min-height: 5;
    border: round $primary;
    margin-top: -1;
}

#status-section:focus-within {
    border: round $accent;
}

#status-text {
    color: $success;
    height: 1;
    padding: 0;
}

#dir-path {
    color: $text-muted;
    height: 1;
    padding: 0;
}

/* ─────────────────────────────────────────────────────────────────────────────
   KEY HELPER BAR
   ───────────────────────────────────────────────────────────────────────────── */
#key-helper {
    dock: bottom;
    height: auto;
    color: $text-muted;
    padding: 0 1;
    border-top: none;
}

/* ─────────────────────────────────────────────────────────────────────────────
   MODAL SCREENS
   ───────────────────────────────────────────────────────────────────────────── */
ModalScreen {
    align: center middle;
    background: $background 80%;
}

#change-dir-modal {
    width: 70;
    height: 28;
    border: round $primary;
    padding: 1 2;
    background: $surface;
}

.modal-title {
    text-align: center;
    text-style: bold;
    color: $primary;
    margin: 0 0 1 0;
    height: 1;
}

.modal-subtitle {
    color: $text-muted;
    margin: 0;
    height: 1;
}

#path-input-section {
    height: auto;
    margin: 0 0 1 0;
}

#dir-input {
    height: 3;
    padding: 0 1;
}

.validation-msg {
    height: 1;
    margin: 0;
    padding: 0;
}

#nav-buttons {
    height: 3;
    margin: 0 0 1 0;
    align: center middle;
}

.nav-btn {
    margin: 0 1;
    height: 3;
    width: auto;
    min-width: 10;
    background: transparent;
    border: round $primary;
    color: $text;
}

.nav-btn:hover,
.nav-btn:focus {
    background: transparent;
    border: double $accent;
    color: $accent;
    text-style: bold;
}

#folder-explorer-section {
    height: 1fr;
    border: round $secondary;
    margin: 0 0 1 0;
    padding: 0 1;
}

#folder-tree {
    height: 1fr;
}

.modal-buttons {
    height: 3;
    align: center middle;
    dock: bottom;
}

#btn-modal-cancel {
    margin-right: 2;
    background: transparent;
    border: round $primary;
    color: $text;
    width: auto;
    min-width: 12;
}

#btn-modal-cancel:hover,
#btn-modal-cancel:focus {
    background: transparent;
    border: double $accent;
    color: $accent;
    text-style: bold;
}

#btn-modal-confirm {
    background: transparent;
    border: round $success;
    color: $success;
    width: auto;
    min-width: 12;
}

#btn-modal-confirm:hover,
#btn-modal-confirm:focus {
    background: transparent;
    border: double $accent;
    color: $accent;
    text-style: bold;
}

/* ─────────────────────────────────────────────────────────────────────────────
   HELP SCREEN
   ───────────────────────────────────────────────────────────────────────────── */
#help-overlay {
    width: 50;
    height: auto;
    max-height: 24;
    border: round $primary;
    padding: 1 2;
}

.help-title {
    text-align: center;
    text-style: bold;
    color: $primary;
    border-bottom: solid $surface-lighten-2;
    padding-bottom: 1;
    margin-bottom: 1;
    height: auto;
}

.help-content {
    height: auto;
}

/* ─────────────────────────────────────────────────────────────────────────────
   NOTIFICATIONS
   ───────────────────────────────────────────────────────────────────────────── */
Toast.-information {
    border: round $success;
}

Toast.-warning {
    border: round $warning;
}

Toast.-error {
    border: round $error;
}

/* ─────────────────────────────────────────────────────────────────────────────
   COPY PROGRESS MODAL
   ───────────────────────────────────────────────────────────────────────────── */
#progress-modal {
    width: 50;
    height: auto;
    max-height: 14;
    border: round $primary;
    padding: 1 2;
    background: $background;
    align: center middle;
}

#progress-modal .modal-title {
    text-align: center;
    text-style: bold;
    color: $primary;
    border-bottom: solid $surface-lighten-2;
    padding-bottom: 1;
    margin-bottom: 1;
    height: auto;
}

#progress-status {
    text-align: center;
    color: $text;
    margin-bottom: 1;
    height: auto;
}

#copy-progress {
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

#copy-progress Bar {
    color: $success;
    background: $surface;
}

#copy-progress PercentageStatus {
    color: $text;
    text-style: bold;
}

#progress-file {
    text-align: center;
    height: auto;
    margin-bottom: 1;
}

#progress-modal .modal-buttons {
    width: 100%;
    height: auto;
    align: center middle;
    margin-top: 1;
}

#btn-cancel-copy {
    background: transparent;
    border: round $error;
    color: $error;
    width: auto;
    min-width: 12;
}

#btn-cancel-copy:hover,
#btn-cancel-copy:focus {
    background: $error 30%;
    border: double $error;
    color: $error;
    text-style: bold;
}

/* ─────────────────────────────────────────────────────────────────────────────
   SETTINGS MODAL
   ───────────────────────────────────────────────────────────────────────────── */
#settings-modal {
    width: 76;
    height: 1fr;
    margin: 2 4;
    border: round $primary;
    padding: 1 2;
    background: $surface;
}

#settings-title {
    dock: top;
}

#settings-scroll {
    height: 1fr;
    scrollbar-size: 1 1;
}

#settings-columns {
    height: auto;
    width: 100%;
}

#settings-description {
    height: auto;
    margin: 0 0 1 0;
    padding: 0;
}

#settings-description-dirs {
    height: auto;
    margin: 0 0 1 0;
    padding: 0;
}

#settings-section {
    width: 1fr;
    height: auto;
    padding: 0;
    margin-right: 2;
}

#settings-section-dirs {
    width: 1fr;
    height: auto;
    padding: 0;
}

#settings-format-section {
    height: auto;
    margin-top: 1;
    padding: 0;
}

#settings-format-label {
    height: 1;
    padding: 0;
    margin: 0 0 1 0;
}

#settings-format-options {
    height: auto;
    layout: horizontal;
    width: 100%;
    padding: 0;
    margin: 0;
}

#settings-format-options FormatOption {
    width: auto;
    height: 3;
    padding: 0 2;
    margin: 0 1 0 0;
    background: transparent;
    color: $text;
    border: blank;
    content-align: center middle;
}

#settings-format-options FormatOption:focus {
    background: transparent;
    border: double $accent;
    color: $accent;
    text-style: bold;
}

#settings-format-options FormatOption:hover {
    background: transparent;
    border: double $accent;
    color: $accent;
}

#settings-treeview-section {
    height: auto;
    margin-top: 1;
    padding: 0;
}

#settings-treeview-label {
    height: 1;
    padding: 0;
    margin: 0 0 1 0;
}

#settings-treeview-options {
    height: auto;
    layout: horizontal;
    width: 100%;
    padding: 0;
    margin: 0;
}

#settings-treeview-options FormatOption {
    width: auto;
    height: 3;
    padding: 0 2;
    margin: 0 1 0 0;
    background: transparent;
    color: $text;
    border: blank;
    content-align: center middle;
}

#settings-treeview-options FormatOption:focus {
    background: transparent;
    border: double $accent;
    color: $accent;
    text-style: bold;
}

#settings-treeview-options FormatOption:hover {
    background: transparent;
    border: double $accent;
    color: $accent;
}

#settings-buttons {
    dock: bottom;
}

.setting-row {
    height: auto;
    margin: 0 0 1 0;
    padding: 0;
}

.setting-label {
    height: 1;
    color: $text;
    padding: 0;
    margin: 0;
}

#settings-modal Input {
    height: 3;
    padding: 0 1;
}

#settings-validation {
    height: 1;
    margin: 0;
    padding: 0;
}

#btn-settings-cancel {
    margin-right: 2;
    background: transparent;
    border: round $primary;
    color: $text;
    width: auto;
    min-width: 12;
}

#btn-settings-cancel:hover,
#btn-settings-cancel:focus {
    background: transparent;
    border: double $accent;
    color: $accent;
    text-style: bold;
}

#btn-settings-save {
    background: transparent;
    border: round $success;
    color: $success;
    width: auto;
    min-width: 12;
}

#btn-settings-save:hover,
#btn-settings-save:focus {
    background: transparent;
    border: double $accent;
    color: $accent;
    text-style: bold;
}